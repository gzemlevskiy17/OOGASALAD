{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oogasalad.team03/game.schema.json",
  "title": "Game File",
  "description": "Catalog of reusable types (components, static objects, terrain) shared by every level of one game.",
  "type": "object",
  "required": [
    "gameId",
    "mainCharacterId",
    "components",
    "staticComponents",
    "terrainTypes"
  ],
  "additionalProperties": false,
  "properties": {
    "gameId": {
      "type": "string",
      "description": "Unique identifier for this game. Levels reference it via gameMetadata.gameType."
    },
    "mainCharacterId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      ],
      "description": "Id, or ordered ids, of the component(s) from components[] treated as the game's main character."
    },
    "components": {
      "type": "array",
      "description": "Movable parts the player can use in the vehicle builder.",
      "items": {
        "$ref": "#/$defs/componentInfo"
      }
    },
    "staticComponents": {
      "type": "array",
      "description": "Placed-on-the-map objects (pickups, hazards, end flag, etc).",
      "items": {
        "$ref": "#/$defs/staticComponentInfo"
      }
    },
    "terrainTypes": {
      "type": "array",
      "description": "Terrain materials available for tracks in any level of this game.",
      "items": {
        "$ref": "#/$defs/terrainInfo"
      }
    },
    "cheats": {
      "type": "array",
      "description": "Optional author-defined cheat keys composed from supported primitive effects.",
      "items": {
        "$ref": "#/$defs/cheatInfo"
      }
    }
  },
  "$defs": {
    "vector2": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "button": {
      "type": "object",
      "description": "On-screen control contributed by a movable component.",
      "required": [
        "name",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "On-screen label, e.g. 'bob jump'. Author is responsible for uniqueness."
        },
        "direction": {
          "$ref": "#/$defs/vector2",
          "description": "Movement vector applied while the button is held."
        }
      }
    },
    "componentInfo": {
      "title": "Movable Component",
      "type": "object",
      "required": [
        "id",
        "spriteUrl",
        "mass"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "spriteUrl": {
          "type": "string"
        },
        "mass": {
          "type": "number",
          "minimum": 0
        },
        "buttons": {
          "type": "array",
          "description": "On-screen buttons this component contributes. Absent or empty = component is not player-controllable.",
          "items": {
            "$ref": "#/$defs/button"
          }
        }
      }
    },
    "staticComponentInfo": {
      "title": "Static Component",
      "type": "object",
      "required": [
        "id",
        "spriteUrl",
        "mass"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "spriteUrl": {
          "type": "string"
        },
        "mass": {
          "type": "number",
          "minimum": 0
        },
        "onCollisionAction": {
          "type": [
            "object",
            "null"
          ],
          "description": "Engine behavior triggered on collision. Null = inert.",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "description": "Registry key, e.g. 'heal', 'damage', 'finish'."
            },
            "amount": {
              "type": "number",
              "description": "Magnitude for actions that take one (heal, damage)."
            }
          }
        }
      }
    },
    "terrainInfo": {
      "title": "Terrain Type",
      "type": "object",
      "required": [
        "id",
        "friction"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "spriteUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "Tile texture. Null falls back to visualColor."
        },
        "visualColor": {
          "type": [
            "string",
            "null"
          ],
          "description": "Solid-color fallback when no sprite is provided."
        },
        "friction": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "cheatInfo": {
      "title": "Cheat Key",
      "type": "object",
      "required": [
        "id",
        "name",
        "enabled",
        "trigger",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "trigger": {
          "$ref": "#/$defs/cheatTriggerInfo"
        },
        "effects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cheatEffectInfo"
          }
        }
      }
    },
    "cheatTriggerInfo": {
      "title": "Cheat Trigger",
      "type": "object",
      "required": [
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "keys": {
          "type": "array",
          "description": "JavaFX KeyCode names that activate the cheat, interpreted as a key chord.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cheatTargetInfo": {
      "title": "Cheat Target",
      "type": [
        "object",
        "null"
      ],
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "description": "Target selector such as mainCharacter, vehicle, allDamageable, componentType, or world."
        },
        "id": {
          "type": "string",
          "description": "Optional selector value, such as a component type id."
        }
      }
    },
    "cheatEffectInfo": {
      "title": "Cheat Effect",
      "type": "object",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Primitive effect type, e.g. repair, damage, teleport, finishRun, loseRun, setGravity, spawnPowerup."
        },
        "target": {
          "$ref": "#/$defs/cheatTargetInfo"
        },
        "parameters": {
          "type": "object",
          "description": "Effect-specific parameters. For spawnPowerup, use componentId, x, and y.",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    }
  }
}
