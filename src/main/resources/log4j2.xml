<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 configuration for the oogasalad app.
  monitorInterval="30" reloads this file every 30s, so you can change levels
  in a running app without a restart.
-->
<Configuration monitorInterval="30" status="WARN">

  <Appenders>
    <Console name="Console" target="SYSTEM_OUT">
      <PatternLayout pattern="${LOG_PATTERN}"/>
    </Console>

    <RollingFile fileName="${LOG_DIR}/oogasalad.log"
      filePattern="${LOG_DIR}/oogasalad-%d{yyyy-MM-dd}-%i.log.gz"
      name="RollingFile">
      <DefaultRolloverStrategy max="10"/>
      <PatternLayout pattern="${LOG_PATTERN}"/>
      <Policies>
        <SizeBasedTriggeringPolicy size="10 MB"/>
        <TimeBasedTriggeringPolicy interval="1"/>
      </Policies>
    </RollingFile>
  </Appenders>

  <Loggers>
    <!-- Our code -->
    <Logger additivity="false" level="info" name="oogasalad">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="RollingFile"/>
    </Logger>

    <!-- Quiet noisy third-party libs (sqlite-jdbc routes through SLF4J -> log4j2) -->
    <Logger level="warn" name="org.sqlite"/>

    <Root level="warn">
      <AppenderRef ref="Console"/>
      <AppenderRef ref="RollingFile"/>
    </Root>
  </Loggers>

  <Properties>
    <Property name="LOG_DIR">log</Property>
    <Property name="LOG_PATTERN">%d{HH:mm:ss.SSS} %-5level [%t] %logger{1.} - %msg%n</Property>
  </Properties>
</Configuration>
